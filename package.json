{
  "name": "rxjs-statemachine",
  "version": "0.1.0",
  "description": "A tiny generic RxJS 7 state machine driven by dynamic Reducer<S> streams: merge -> scan -> shareState.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/createStateMachine.test.js dist/test/shareState.test.js"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rxjs": "7.8.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "rxjs",
    "state",
    "state-machine",
    "functional-programming",
    "frp",
    "scan"
  ],
  "license": "MIT"
}
