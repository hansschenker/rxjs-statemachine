{
  "name": "rxjs-statemachine",
  "version": "0.1.0",
  "description": "A generic RxJS Action State Machine: Subject as action input port, Observable as action stream, scan as state reducer, shareReplay(1) as remembered state.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "rxjs",
    "state-machine",
    "flux",
    "subject",
    "scan",
    "shareReplay",
    "typescript"
  ],
  "author": "Hans Schenker",
  "license": "MIT",
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
